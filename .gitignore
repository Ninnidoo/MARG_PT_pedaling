# =========================================================
# Python
# =========================================================
.venv/
venv/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# =========================================================
# Secrets and local configuration
# =========================================================
.env
.env.*
!.env.example

.vscode/
.idea/

# =========================================================
# Checkpoints and model weights
# =========================================================
checkpoints/**
!checkpoints/.gitkeep

*.ckpt
*.pt
*.pth
*.bin
*.safetensors

# =========================================================
# Generated experiment outputs
# =========================================================
outputs/**

!outputs/midi/
!outputs/midi/.gitkeep

!outputs/audio/
!outputs/audio/.gitkeep

!outputs/figures/
!outputs/figures/.gitkeep

# =========================================================
# Local datasets and intermediate files
# =========================================================
data/raw/**
!data/raw/.gitkeep

data/interim/**
!data/interim/.gitkeep

data/processed/**
!data/processed/.gitkeep

# =========================================================
# Logs and experiment artifacts
# =========================================================
logs/**
!logs/.gitkeep

experiments/
runs/
wandb/

# =========================================================
# Generated media
# =========================================================
*.wav
*.flac
*.mp3

# MIDI files produced during experiments
*.mid
*.midi

# =========================================================
# External source repositories
# =========================================================
third_party/PianistTransformer/
# =========================================================
# Curated research records
# =========================================================
# Keep generated analysis data local. Only human-readable reports and
# publication-ready figures are candidates for GitHub. Files that were
# already tracked remain tracked until explicitly removed from the index.
analysis/**
!analysis/**/
!analysis/**/*.md
!analysis/**/*.png
!analysis/**/*.py
!analysis/**/*.js
!analysis/**/*.css
!analysis/**/*.html
!analysis/**/.gitkeep

# Local scratch and interrupted-edit artifacts
*.orig
*.rej
*.run.lock*
